{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ragdb;Username=raguser;Password=ragpass"
  },
  "App": {
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "EmbeddingModel": "nomic-embed-text",
      "EmbeddingDimension": 768,
      "ChatModel": "llama3.2"
    },
    "OllamaResilience": {
      "AttemptTimeout": "00:02:00",
      "TotalRequestTimeout": "00:03:00",
      "StreamingIdleTimeout": "00:00:30",
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerMinimumThroughput": 4,
      "CircuitBreakerSamplingDuration": "00:04:00",
      "CircuitBreakerBreakDuration": "00:00:30"
    },
    "RateLimiting": {
      "Enabled": true,
      "RedisConnectionString": "localhost:6379,abortConnect=false",
      "RedisConnectTimeoutMilliseconds": 5000,
      "StateTtlSeconds": 3600,
      "Documents": { "Capacity": 20, "RefillTokens": 20, "RefillPeriodSeconds": 60 },
      "Search": { "Capacity": 60, "RefillTokens": 60, "RefillPeriodSeconds": 60 },
      "Ask": { "Capacity": 20, "RefillTokens": 20, "RefillPeriodSeconds": 60 },
      "AskStream": { "Capacity": 10, "RefillTokens": 10, "RefillPeriodSeconds": 60 }
    },
    "Chunking": {
      "ChunkSize": 400,
      "ChunkOverlap": 100
    },
    "Search": {
      "MinSimilarity": 0.3,
      "DefaultTopK": 5,
      "MaxTopK": 20,
      "RetrievalMode": "vector",
      "CandidateLimit": 50,
      "RrfConstant": 60
    },
    "Rag": {
      "MaxQuestionLength": 2000,
      "MaxModelContextTokens": 4096,
      "ReservedResponseTokens": 1024,
      "EstimatedCharactersPerToken": 4.0
    }
  },
  "OpenTelemetry": {
    "ServiceName": "SemanticRagSearch.Api",
    "ExportEnabled": true,
    "OtlpEndpoint": "http://localhost:4318"
  },
  "AllowedHosts": "*"
}
